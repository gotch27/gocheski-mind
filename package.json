{
  "name": "gocheski-mind",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.3.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @gocheski-mind/web",
    "dev:web": "npm run dev --workspace @gocheski-mind/web",
    "build": "npm run build --workspace @gocheski-mind/web && npm run build --workspace @gocheski-mind/extension",
    "build:web": "npm run build --workspace @gocheski-mind/web",
    "build:extension": "npm run build --workspace @gocheski-mind/extension",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspace @gocheski-mind/web",
    "db:generate": "npm run db:generate --workspace @gocheski-mind/web",
    "db:migrate": "npm run db:migrate --workspace @gocheski-mind/web",
    "db:push": "npm run db:push --workspace @gocheski-mind/web"
  }
}
