# Neon Postgres connection string.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Added automatically when a Vercel Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_example

# Reuse the values configured for gocheski.com/admin so both apps share a login session.
ADMIN_TOKEN=replace-with-the-shared-admin-token
SESSION_SECRET=replace-with-the-shared-session-secret

# Separate revocable credential used only by the private Chrome extension.
MIND_EXTENSION_TOKEN=replace-with-a-random-extension-token

# Leave empty in local development. Production builds default to /mind.
NEXT_PUBLIC_BASE_PATH=
