# Neon Postgres connection string.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Added automatically when a Vercel Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_example

# Enable Neon Auth in the Neon Console, then copy its Auth URL here.
NEON_AUTH_BASE_URL=https://your-neon-auth-endpoint.example/auth

# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters

# Comma-separated Google addresses allowed to use Mind. Leave empty to allow
# any Google account to register.

# Leave empty in local development. Set to /mind only when simulating the
# production subpath locally; Vercel production builds already default to /mind.
NEXT_PUBLIC_BASE_PATH=
